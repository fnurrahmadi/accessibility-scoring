# Copy this file to .streamlit/secrets.toml for local use. Never commit the copied file.
# In Supabase: Connect -> Session pooler -> copy the connection string, then append
# ?sslmode=require (or &sslmode=require if the URL already contains a query string).
DATABASE_URL = "postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
